    <dashboard enable-sort-zone-taborder='true' name='Slide 4: Income vs Campaign'>
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_12' value='top' />
          <format attr='vertical-align' id='dash-text_9' value='top' />
