    <worksheet name='2. Total Spend by Education'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Total Spend by Education</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>Sum of Total Spend for each Education.  Color shows details about Education.  The marks are labeled by sum of Total Spend.

Created a calculated field called TOTAL SPEND, where I added up all the Product columns: Fish, Fruits, Wine, Meat, Gold, Sweets.

- We can see a consistent trend where most customers who spend and engage with the campaings are those who have graduated</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Capstone-Retail Analytics by Inigo Arboleda' name='federated.1axk95m0px4xhh19h5lsh0q82ydb' />
          </datasources>
          <datasource-dependencies datasource='federated.1axk95m0px4xhh19h5lsh0q82ydb'>
            <column caption='Total Spend' datatype='integer' name='[Calculation_3669418703953922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[MntWines]+&#10;[MntFruits]+&#10;[MntMeatProducts]+&#10;[MntFishProducts]+&#10;[MntSweetProducts]+&#10;[MntGoldProds]' />
            </column>
            <column datatype='string' name='[Education]' role='dimension' type='nominal' />
            <column datatype='integer' name='[ID]' role='dimension' type='ordinal' />
            <column caption='Mnt Fish Products' datatype='integer' name='[MntFishProducts]' role='measure' type='quantitative' />
            <column caption='Mnt Fruits' datatype='integer' name='[MntFruits]' role='measure' type='quantitative' />
            <column caption='Mnt Gold Prods' datatype='integer' name='[MntGoldProds]' role='measure' type='quantitative' />
            <column caption='Mnt Meat Products' datatype='integer' name='[MntMeatProducts]' role='measure' type='quantitative' />
            <column caption='Mnt Sweet Products' datatype='integer' name='[MntSweetProducts]' role='measure' type='quantitative' />
            <column caption='Mnt Wines' datatype='integer' name='[MntWines]' role='measure' type='quantitative' />
            <column-instance column='[ID]' derivation='CountD' name='[ctd:ID:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Education]' derivation='None' name='[none:Education:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3669418703953922]' derivation='Sum' name='[sum:Calculation_3669418703953922:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.1axk95m0px4xhh19h5lsh0q82ydb].[sum:Calculation_3669418703953922:qk]' value='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' />
          </style-rule>
          <style-rule element='header'>
            <format attr='height-header' value='17' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.1axk95m0px4xhh19h5lsh0q82ydb].[none:Education:nk]' />
              <lod column='[federated.1axk95m0px4xhh19h5lsh0q82ydb].[ctd:ID:qk]' />
              <text column='[federated.1axk95m0px4xhh19h5lsh0q82ydb].[sum:Calculation_3669418703953922:qk]' />
