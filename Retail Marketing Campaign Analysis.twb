        <zone forceUpdate='true' h='19167' id='5' type-v2='text' w='15692' x='1077' y='15521'>
          <formatted-text>
            <run fontcolor='#000000' fontsize='10'>Q - Does Household influence </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10'>Campaign Response?</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='10'>H4 - Customers with children and/or teenagers </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10'>at home are less likely to engage with marketing campaigns compared to customers without dependants.</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='13438' id='6' type-v2='text' w='98077' x='1000' y='1458'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='36'>Household vs Campaign Response</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='62604' id='12' type-v2='text' w='15615' x='1077' y='35833'>
          <formatted-text>
            <run fontcolor='#000000' fontsize='12'>Key Findings:</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='8'>Campaign Response Line Chart:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'> - Kidhome 1: 25.3%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'> - Kidhome 2: 10.4%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'> - Teenhome 1: 28.3%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'> - Teenhome 2: 40.4%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'> - 0 dependents: 59.3%</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='8'>Avg. Total Spend Chart:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'> - Elseif: </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'> - No dependents, Teenagers only, </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'>children only, and both</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'>- No dep. most avg. spend</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='8'>Total Spend Box Plot:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'> - No dependants $703,262 TOTAL</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'> - Teenagers Only $458,835 TOTAL</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'> - Children Only $96,614 TOTAL</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'> - Both children and teenagers $95,044 TOTAL</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'> - Customers with No dependants have the highest median spend. </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'> - Customers with both children and teenagers show the lowest overall spending</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'>Æ </run>
            <run>Æ&#10;</run>
