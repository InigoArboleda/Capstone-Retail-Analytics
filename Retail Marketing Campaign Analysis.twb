            <column datatype='integer' name='[Teenhome]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3669418703953922]' derivation='Avg' name='[avg:Calculation_3669418703953922:qk]' pivot='key' type='quantitative' />
