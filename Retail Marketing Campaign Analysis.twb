      <column caption='Age Group' datatype='string' name='[Age_Group]' role='dimension' type='nominal' />
      <column caption='CMP5 RATE ' datatype='real' name='[CMP1 RATE (copy) (copy) (copy) (copy) (copy)_3669418714390537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([AcceptedCmp5])/count([ID]) * 100' />
      </column>
      <column caption='CMP6 RATE ' datatype='real' name='[CMP1 RATE (copy) (copy) (copy) (copy)_3669418714386440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Response])/count([ID]) * 100' />
      </column>
      <column caption='CMP4 RATE ' datatype='real' name='[CMP1 RATE (copy) (copy) (copy)_3669418714378247]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([AcceptedCmp4])/count([ID]) * 100' />
      </column>
      <column caption='CMP3 RATE ' datatype='real' name='[CMP1 RATE (copy) (copy)_3669418714365958]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([AcceptedCmp3])/count([ID]) * 100' />
      </column>
      <column caption='CMP2 RATE ' datatype='real' name='[CMP1 RATE (copy)_3669418714357765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([AcceptedCmp2])/count([ID]) * 100' />
      </column>
      <column caption='CmpTotal' datatype='integer' name='[Calculation_3669418422517760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[AcceptedCmp1]+[AcceptedCmp2]+[AcceptedCmp3]+[AcceptedCmp4]+[AcceptedCmp5]+[Response]' />
      </column>
      <column caption='Total Spend' datatype='integer' name='[Calculation_3669418703953922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[MntWines]+&#10;[MntFruits]+&#10;[MntMeatProducts]+&#10;[MntFishProducts]+&#10;[MntSweetProducts]+&#10;[MntGoldProds]' />
      </column>
      <column caption='CMP1 RATE' datatype='real' name='[Calculation_3669418714136580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([AcceptedCmp1])/count([ID]) * 100' />
      </column>
      <column caption='Total Cmps Accepted ' datatype='integer' name='[Calculation_3669418721939466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[AcceptedCmp1]+&#10;[AcceptedCmp2] +&#10;[AcceptedCmp3] +&#10;[AcceptedCmp4] +&#10;[AcceptedCmp5] +&#10;[Response]' />
      </column>
      <column caption='Income Band' datatype='string' name='[Calculation_3669419706220555]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Income] &lt; 20000 THEN &apos;Under $20K&apos;&#10;ELSEIF [Income] &lt; 40000 THEN &apos;$20K - $40K&apos;&#10;ELSEIF [Income] &lt; 60000 THEN &apos;$40K - $60K&apos;&#10;ELSEIF [Income] &lt; 80000 THEN &apos;$60K - $80K&apos;&#10;ELSEIF [Income] &lt; 100000 THEN &apos;$80K - $100K&apos;&#10;ELSE &apos;Over $100K&apos;&#10;END' />
      </column>
      <column caption='Household Type' datatype='string' name='[Calculation_3669419738980367]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Kidhome]= 0 and [Teenhome]= 0 then &apos;No Dependants&apos;&#10;ElseIf [Kidhome] &gt; 0 and [Teenhome]= 0 then &apos;Children Only&apos;&#10;ElseIF [Kidhome]= 0 and [Teenhome] &gt; 0 then &apos;Teenagers Only&apos;&#10;ELSE &apos;Both Children &amp; Teenagers&apos;&#10;END' />
      </column>
      <column caption='Superior Channel' datatype='string' name='[Calculation_3669419757363216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [NumWebPurchases] &gt; [NumCatalogPurchases] and [NumWebPurchases]&gt; [NumDealsPurchases]&#10;then &apos;Web&apos;&#10;ELSEIF [NumCatalogPurchases] &gt; [NumStorePurchases] then &apos;Catalog&apos;&#10;ELSE &apos;Store&apos;&#10;END' />
      </column>
      <column caption='Responded Avg Income' datatype='real' name='[Calculation_3669420102959122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(if([Response_Total]) = 1 THEN [Income] end)' />
      </column>
      <column caption='No response avg income' datatype='real' name='[Calculation_3669420103708691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(if[Response_Total] = 0 then [Income] end)' />
      </column>
      <column caption='avg income difference' datatype='real' name='[Calculation_3669420104282132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Response_Total] = 1 THEN [Income] END) -&#10;AVG(IF [Response_Total] = 0 THEN [Income] END)' />
      </column>
      <column caption='AvgResponse' datatype='real' name='[Calculation_3669420113428501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([Response_Total]) * 100' />
      </column>
      <column caption='PhD Rate' datatype='real' name='[Calculation_3669420128477206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(if[Education] = &apos;PhD&apos; then [Response_Total] end) * 100' />
      </column>
      <column caption='Basic Response rate' datatype='real' name='[Calculation_3669420129497111]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(if [Education] = &apos;Basic&apos; then [Response_Total] end) * 100' />
      </column>
      <column caption='ed difference' datatype='real' name='[Calculation_3669420129902616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(if[Education] = &apos;PhD&apos; then [Response_Total] end) - AVG(if [Education] = &apos;Basic&apos; then [Response_Total] end)' />
      </column>
      <column caption='Mean age respond' datatype='real' name='[Calculation_3669420140232729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(if[Response_Total] = 1 THEN [Age]end)' />
      </column>
      <column caption='KPI: Avg kids responded' datatype='real' name='[Calculation_3669420423675931]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(if[Response_Total] = 1 then [Kidhome]END)' />
      </column>
      <column caption='Web Response Rate' datatype='real' name='[Calculation_3669420432621598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(if[NumWebPurchases] &gt; 0 then [Response_Total] end)* 100' />
      </column>
      <column caption='Catalog Response Rate' datatype='real' name='[Calculation_3669420432850975]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Avg(if[NumCatalogPurchases] &gt; 0 then [Response_Total] end) *100' />
      </column>
      <column caption='Store Response Rate' datatype='real' name='[Calculation_3669420433063968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg (if [NumStorePurchases] &gt; 0 then [Response_Total] end) * 100' />
