            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='30521' id='5' type-v2='text' w='65154' x='16154' y='15313'>
          <formatted-text>
            <run fontcolor='#000000' fontsize='15'>KEY FINDINGS:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='15'>• Campaign 6 best performer:  14.93% </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='15'>• Campaign 2 worst performer: 1.34%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='15'>• Wines highest total spend   </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='15'>• Meat Products 2nd highest</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='15'>• Wines &amp; Meat strongest </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='15'>  predictors of response</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='15'>• 1629 out of 2236 customers (72.8%) </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='15'>did not engage with marketing campaigns</run>
            <run>Æ&#10;</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='13438' id='6' type-v2='text' w='98077' x='1000' y='1458'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='36'>Conclusion and Recommendations</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='51667' id='12' type-v2='text' w='65000' x='16308' y='47083'>
          <formatted-text>
            <run fontcolor='#000000' fontsize='15'>RECOMMENDATIONS:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'>Majority of our customers do not respond to</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'>marketing campaigns.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'>But if we target and take action based on the analysis we can seek for better customer response</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='15'>HYPOTHESIS RESULTS</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='15'>Æ </run>
            <run fontcolor='#000000' fontsize='12'>H1 — Income significantly predicts response</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'> H2 — Education significantly predicts response</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'> H3 — Older age groups are more engaged (56+ most)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'> H4 — Household composition impacts engagement</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'> H5 — Purchase channel partially drives response</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='15'>Overall Insight:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'>• Our marketing campaigns are not that responsive/successful</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'>• Target high income customers ($60K+)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'>• Focus campaigns on Graduate Level customers</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'>• Prioritize customers 45 years old and above</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'>• Target customers with no dependants</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'>• Focus digital marketing on catalog and web shoppers</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'>• Promote Wines &amp; Meat in campaigns</run>
            <run>Æ&#10;</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
        <zone h='11458' id='145' is-scaled='1' param='/Users/inigoarboleda/Downloads/logo.png' type-v2='bitmap' w='14615' x='1231' y='1667' />
