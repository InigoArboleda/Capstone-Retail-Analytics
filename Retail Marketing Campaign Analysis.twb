    <dashboard enable-sort-zone-taborder='true' name='Slide 2: Business Objective'>
      <style />
      <size maxheight='960' maxwidth='1300' minheight='960' minwidth='1300' sizing-mode='range' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98334' id='1' type-v2='empty' w='98770' x='615' y='833'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f5f5f5' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='21354' id='5' type-v2='text' w='97923' x='1000' y='13542'>
          <formatted-text>
            <run fontcolor='#000000' fontsize='26'>OBJECTIVE</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='20'>This analysis project will aim to identify which customer characteristics and behaviors are most likely to drive positive engagement to retail marketing campaigns, all in effort to allow for a more strategic and effective marketing approach.</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='11979' id='6' type-v2='text' w='97923' x='1000' y='1458'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='36'>Business Objective &amp; Project Overview</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='33333' id='9' type-v2='text' w='42846' x='1000' y='35625'>
          <formatted-text>
            <run fontcolor='#000000' fontsize='26'>Dataset</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - 2236 customers</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - 6 campaigns</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - 6 products</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - 3 purchase channels</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - Years: 2012 - 2014</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - 30 Columns and 2237 rows</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='28854' id='12' type-v2='text' w='42846' x='1000' y='69792'>
          <formatted-text>
            <run fontcolor='#000000' fontsize='26'>Hypotheses (Factors)</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - H1: Income</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - H2: Education</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - H3: Age</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - H4: Household</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - H5: Purchase</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='33333' id='13' type-v2='text' w='54769' x='44231' y='35625'>
          <formatted-text>
            <run fontcolor='#000000' fontsize='26'>Key Questions</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - Which factors/demographics drive campaign engagement?</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - Which campaign performed the best?</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - Is there significance on whether spending habits impact customer response?</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='28854' id='14' type-v2='text' w='54692' x='44231' y='69792'>
          <formatted-text>
            <run fontcolor='#000000' fontsize='26'>Tools Used</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - Sqlite </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='20'>   - Excel</run>
            <run>Æ&#10;&#10;</run>
