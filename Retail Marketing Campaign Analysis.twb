          <format attr='vertical-align' id='dash-text_5' value='top' />
          <format attr='vertical-align' id='dash-text_6' value='center' />
        </style-rule>
      </style>
      <size maxheight='960' maxwidth='1300' minheight='960' minwidth='1300' sizing-mode='range' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98334' id='36' param='horz' type-v2='layout-flow' w='98770' x='615' y='833'>
            <zone h='98334' id='34' type-v2='layout-basic' w='98770' x='615' y='833'>
              <zone h='98334' id='1' type-v2='empty' w='98770' x='615' y='833'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='30521' id='5' type-v2='text' w='15692' x='1077' y='15521'>
          <formatted-text>
            <run fontcolor='#000000' fontsize='12'>Q - Does Income influence </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'>Campaign Response?</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='12'>H1 - Customers with higher income are more likely to cater to the marketing campaigns as opposed to customers with lower incomes.</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='13438' id='6' type-v2='text' w='98077' x='1000' y='1458'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='36'>Income vs Campaign Response</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='48542' id='12' type-v2='text' w='15615' x='1077' y='46875'>
          <formatted-text>
            <run fontcolor='#000000' fontsize='12'>Key Findings:</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000'>Boxplot:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'> - Avg income Response: $56k</run>
